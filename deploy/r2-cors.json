{
  "rules": [
    {
      "allowed": {
        "origins": ["https://verea.pages.dev", "http://localhost:5173"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-Match", "If-None-Match"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
